# Local PostgreSQL connection string. Never commit a real credential.
DATABASE_URL="postgresql://user:password@localhost:5432/grimorio?schema=public"
# Generate a long random value for each environment.
SESSION_SECRET="replace-with-a-long-random-secret"
# Obrigatórios apenas para criar o primeiro Mestre com `npm run db:seed`.
INITIAL_GM_USERNAME="mestre"
INITIAL_GM_PASSWORD="replace-with-a-unique-password-of-at-least-12-characters"
